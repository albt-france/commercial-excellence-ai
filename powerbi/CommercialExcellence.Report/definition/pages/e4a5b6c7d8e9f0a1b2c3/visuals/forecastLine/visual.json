          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly revenue: actual (black), hold-out check (light blue), forecast Nov-Dec (blue), target (grey)'"
                }
              }
            }
          }
        }
