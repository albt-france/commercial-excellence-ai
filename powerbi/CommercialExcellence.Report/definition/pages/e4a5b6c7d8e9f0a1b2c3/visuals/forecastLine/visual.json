                  "Expression": {
                    "SourceRef": {
                      "Entity": "Forecast Monthly"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "Forecast Monthly.month",
              "nativeQueryRef": "month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Monthly Actual"
                }
              },
              "queryRef": "_Measures.Monthly Actual",
              "nativeQueryRef": "Monthly Actual",
              "displayName": "Actual"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Hold-out Prediction"
                }
              },
              "queryRef": "_Measures.Hold-out Prediction",
              "nativeQueryRef": "Hold-out Prediction",
