            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Monthly Forecast"
                }
              },
              "queryRef": "_Measures.Monthly Forecast",
              "nativeQueryRef": "Monthly Forecast",
              "displayName": "Forecast"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Monthly Target"
                }
              },
              "queryRef": "_Measures.Monthly Target",
              "nativeQueryRef": "Monthly Target",
              "displayName": "Target"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0B0B0B'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Monthly Actual"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#86B6EF'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Hold-out Prediction"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2A78D6'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Monthly Forecast"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#B4B2A9'"
                    }
                  }
                }
              }
            }
          },
