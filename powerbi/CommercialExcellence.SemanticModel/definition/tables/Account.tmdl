/// SIMULATED hospitals, with the account scorecard of sql/04_account_risk.sql (segment, risk flag, Pareto rank)
table Account
	lineageTag: efd4a9f3-f4c0-5927-b4d2-2fe2440176c5

	column account_id
		dataType: string
		isKey
		lineageTag: 13293304-6587-5733-ad5f-be8700ca6f2a
		summarizeBy: none
		sourceColumn: account_id

	column account_name
		dataType: string
		lineageTag: 6f19cfc2-aecd-5e51-8918-619906f1e271
		summarizeBy: none
		sourceColumn: account_name

	column account_type
		dataType: string
		lineageTag: c345f954-8ff8-5fce-9241-f1bd2f17a782
		summarizeBy: none
