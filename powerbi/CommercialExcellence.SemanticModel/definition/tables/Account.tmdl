	partition Account = m
		mode: import
		source =
				let
					Base = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "clean\accounts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {"account_id", "account_name", "account_type"}),
					Card = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "output\04_accounts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
					CardCols = Table.SelectColumns(Card, {"account_id", "country", "region", "first_invoice", "revenue_l12m", "revenue_p12m", "revenue_l3m", "revenue_l3m_ly", "growth_l12m", "growth_l3m", "is_new_account", "risk_flag", "revenue_rank", "cum_revenue_share", "size_percentile", "segment"}),
					Merged = Table.NestedJoin(Base, {"account_id"}, CardCols, {"account_id"}, "card", JoinKind.LeftOuter),
					Expanded = Table.ExpandTableColumn(Merged, "card", {"country", "region", "first_invoice", "revenue_l12m", "revenue_p12m", "revenue_l3m", "revenue_l3m_ly", "growth_l12m", "growth_l3m", "is_new_account", "risk_flag", "revenue_rank", "cum_revenue_share", "size_percentile", "segment"}),
					Filled = Table.ReplaceValue(Table.ReplaceValue(Expanded, null, "6 · No sales in the last 24 months", Replacer.ReplaceValue, {"segment"}), null, "Inactive", Replacer.ReplaceValue, {"risk_flag"}),
					Typed = Table.TransformColumnTypes(Filled, {{"account_id", type text}, {"account_name", type text}, {"account_type", type text}, {"country", type text}, {"region", type text}, {"first_invoice", type date}, {"revenue_l12m", type number}, {"revenue_p12m", type number}, {"revenue_l3m", type number}, {"revenue_l3m_ly", type number}, {"growth_l12m", type number}, {"growth_l3m", type number}, {"is_new_account", type logical}, {"risk_flag", type text}, {"revenue_rank", Int64.Type}, {"cum_revenue_share", type number}, {"size_percentile", type number}, {"segment", type text}}, "en-US")
				in
					Typed

