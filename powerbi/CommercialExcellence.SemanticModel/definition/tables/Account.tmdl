	column country
		dataType: string
		lineageTag: e1340dfc-0ab9-5019-a779-0eaf5a5849e0
		summarizeBy: none
		sourceColumn: country

	column region
		dataType: string
		lineageTag: b5ae9e6e-b13f-5efe-bb64-789ac4241c36
		summarizeBy: none
		sourceColumn: region

	column first_invoice
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 7651c4f8-6593-51d2-8346-67504d67c705
		summarizeBy: none
		sourceColumn: first_invoice

		annotation UnderlyingDateTimeDataType = Date

	column revenue_l12m
