/// 30 test questions: gold SQL written by hand vs SQL generated by Claude (ai/run_eval.py)
table 'AI SQL Eval'
	lineageTag: 5a9c1749-df96-506c-bf45-54c720070125

	column id
		dataType: int64
		formatString: 0
		lineageTag: 9792cf89-d964-5e1e-9f9f-c8859918e43d
		summarizeBy: none
		sourceColumn: id

	column category
		dataType: string
		lineageTag: bd71c4b2-68b2-5a9a-b15d-39818bb83397
		summarizeBy: none
		sourceColumn: category

	column question
		dataType: string
		lineageTag: 53a3f2fe-5f89-5c1d-a306-485932c3e039
		summarizeBy: none
		sourceColumn: question

	column gold_answer
		dataType: string
		lineageTag: 358cb7ed-9d83-5d35-8eca-0d90a50d9741
		summarizeBy: none
		sourceColumn: gold_answer

	column generated_answer
		dataType: string
		lineageTag: 50993fe4-8895-5276-9a27-0a401aa700ba
		summarizeBy: none
		sourceColumn: generated_answer

	column correct
		dataType: boolean
		lineageTag: c6861161-ef16-5b98-afc1-33eb0539f453
		summarizeBy: none
		sourceColumn: correct

	column error_type
		dataType: string
		lineageTag: eb4f16a2-1181-5b74-bd49-8f45e9db56bf
		summarizeBy: none
		sourceColumn: error_type

	column analysis
		dataType: string
		lineageTag: b412f8b9-ca77-5290-b733-cf87d4122478
		summarizeBy: none
		sourceColumn: analysis

	partition 'AI SQL Eval' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\ai_eval_results.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"id", "category", "question", "gold_answer", "generated_answer", "correct", "error_type", "analysis"}),
					Typed = Table.TransformColumnTypes(Selected, {{"id", Int64.Type}, {"category", type text}, {"question", type text}, {"gold_answer", type text}, {"generated_answer", type text}, {"correct", type logical}, {"error_type", type text}, {"analysis", type text}}, "en-US")
				in
					Typed

