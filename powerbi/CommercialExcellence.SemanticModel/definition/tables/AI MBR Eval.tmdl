table 'AI MBR Eval'
	lineageTag: ed4b75a8-0e21-5cef-bcc2-5a4e6b533085

	column month
		dataType: string
		lineageTag: 6ef0c6f5-6b9d-5887-a85f-48ec99166c18
		summarizeBy: none
		sourceColumn: month

	column numbers_cited
		dataType: int64
		formatString: #,0
		lineageTag: e6f428ca-dfea-5b7f-98a4-2cab79a406d6
