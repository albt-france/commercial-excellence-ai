		formatString: #,0
		lineageTag: a53de092-632a-5384-8e63-9ee94355e5fb
		summarizeBy: none
		sourceColumn: unsupported_first_draft

	column attempts
		dataType: int64
		formatString: #,0
		lineageTag: d51368c5-327e-5b2d-b1d6-8d3375ea25f3
