					Typed = Table.TransformColumnTypes(Selected, {{"product_id", type text}, {"product_line", type text}, {"revenue_ly", type number}, {"revenue_cy", type number}, {"units_growth", type number}, {"price_effect", type number}, {"price_change_pct", type number}}, "en-US")
