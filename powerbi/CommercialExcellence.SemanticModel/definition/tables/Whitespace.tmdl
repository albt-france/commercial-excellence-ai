		summarizeBy: none
		sourceColumn: region

	column market_value_eur
		dataType: double
		formatString: #,0
		lineageTag: 9419a431-c27d-581f-9c90-f29e006ae5fa
		summarizeBy: none
		sourceColumn: market_value_eur

	column revenue_l12m
		dataType: double
		formatString: #,0
		lineageTag: cca0dfd6-cde7-5489-9b40-b65840afd825
		summarizeBy: none
		sourceColumn: revenue_l12m

	column share_value
		dataType: double
		formatString: 0.0%
		lineageTag: 5ef23624-e49b-5f9c-a16c-a3da297732ad
		summarizeBy: none
		sourceColumn: share_value

	column benchmark_share
		dataType: double
		formatString: 0.0%
		lineageTag: 64a0ffd9-a11e-5139-8454-43d05a861a68
		summarizeBy: none
