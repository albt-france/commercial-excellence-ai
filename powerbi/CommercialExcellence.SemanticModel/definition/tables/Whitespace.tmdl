/// Market size vs our share, untapped potential (sql/01_market_size.sql)
table Whitespace
	lineageTag: 2043bb40-91dc-515b-aa58-4a80eedd8fd9

	column iso3
		dataType: string
		lineageTag: 2b38a1e5-a417-5bc8-bf37-92b722c6a39c
		summarizeBy: none
		sourceColumn: iso3

	column country
		dataType: string
		lineageTag: 3db6fca6-7f2d-5a1e-8105-2b161996f2c4
		summarizeBy: none
