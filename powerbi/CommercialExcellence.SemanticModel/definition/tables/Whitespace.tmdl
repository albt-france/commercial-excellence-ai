	partition Whitespace = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\01_market_whitespace.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"iso3", "country", "region", "market_value_eur", "revenue_l12m", "share_value", "benchmark_share", "untapped_potential_eur", "potential_rank", "potential_share", "quadrant", "revenue_growth_l12m"}),
					Typed = Table.TransformColumnTypes(Selected, {{"iso3", type text}, {"country", type text}, {"region", type text}, {"market_value_eur", type number}, {"revenue_l12m", type number}, {"share_value", type number}, {"benchmark_share", type number}, {"untapped_potential_eur", type number}, {"potential_rank", Int64.Type}, {"potential_share", type number}, {"quadrant", type text}, {"revenue_growth_l12m", type number}}, "en-US")
				in
					Typed

